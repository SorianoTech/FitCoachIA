# Modelo de embeddings. DEBE coincidir con el usado en infra/vector-db/loader/loader.py:
# cambiarlo obliga a re-vectorizar todo el corpus y regenerar el volcado SQL.
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Dimension de exercises.metadata_vector. El servicio no arranca si no coincide.
EMBEDDER_DIMENSIONS=384
# Textos maximos por peticion.
EMBEDDER_MAX_TEXTS=64

# Servicio de embeddings (infra/embedder). DEBE usar el mismo modelo que el
# corpus: all-MiniLM-L6-v2, 384 dimensiones.
embedder_host=localhost
embedder_port=8100
embedder_timeout_seconds=10

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
log_level=INFO
