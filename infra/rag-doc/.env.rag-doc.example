# Copia a infra/rag-doc/.env (no se versiona).
# Puerto local del host donde se publica rag-doc (el proxy NPM apunta al contenedor, no a este puerto)
RAG_PORT=8200
RAG_LOG_LEVEL=INFO
RAG_QDRANT_COLLECTION=rag_doc
# Modelo de embeddings (debe coincidir con el de la imagen y con RAG_EMBEDDING_DIMENSIONS; si cambia, reindexa)
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
# local (E5 de la imagen) | openai (API compatible; text-embedding-3-small=1536). Si cambia, reindexa
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Si se deja vacia usa RAG_LLM_API_KEY
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_TIMEOUT_SECONDS=30
# LLM: cualquier API compatible con OpenAI (OpenRouter por defecto) con un modelo abierto
RAG_LLM_BASE_URL=https://openrouter.ai/api/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_TOKENS=600
RAG_LLM_MAX_RETRIES=2
# minimal|low|medium|high para modelos de razonamiento (gpt-5*: no admiten temperatura); default = modelos normales
RAG_LLM_REASONING_EFFORT=default
# Anti-abuso: peticiones por minuto y por IP, tope diario global y confianza en X-Forwarded-For (NPM)
RAG_RATE_LIMIT_PER_MINUTE=10
RAG_DAILY_CALL_CAP=500
# Voz (los modelos van en la imagen; solo cambia el tamano de Whisper si reconstruyes: tiny|base|small)
RAG_STT_MODEL=small
# Transcripcion: cloud (API OpenAI-compatible, con Whisper local de respaldo) | local
RAG_STT_PROVIDER=cloud
RAG_STT_CLOUD_BASE_URL=https://api.openai.com/v1
RAG_STT_CLOUD_MODEL=gpt-4o-mini-transcribe
# Si se deja vacia usa RAG_LLM_API_KEY
RAG_STT_CLOUD_API_KEY=
RAG_STT_CLOUD_TIMEOUT_SECONDS=20
RAG_TRUST_PROXY_HEADERS=true
# Pasajes recuperados por pregunta y puntuacion coseno minima para responder
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
# Reescritura de la pregunta antes de buscar
RAG_QUERY_REWRITE=true
# Troceado (se aplica al indexar: make rag-index). Max, minimo para fusionar fragmentos pequenos y solape
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_MIN_CHARS=0
RAG_CHUNK_OVERLAP=0
# Reescritura de la pregunta antes de buscar
RAG_QUERY_REWRITE=true