{
  "title": "FitCoachIA - Conversaciones",
  "uid": "fitcoach-conversations",
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["fitcoach"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "postgres",
        "current": { "text": "PostgreSQL Dev", "value": "fitcoach-postgres-dev" },
        "refresh": 1
      },
      {
        "name": "agent",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "${datasource}" },
        "query": "SELECT DISTINCT agent FROM token_usage ORDER BY agent",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "telegram_user_id",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "${datasource}" },
        "query": "SELECT DISTINCT chat_id::text FROM token_usage ORDER BY chat_id::text",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "log_level",
        "type": "custom",
        "options": ["ERROR", "WARNING", "INFO", "DEBUG"],
        "current": { "text": "All", "value": "$__all" },
        "allValue": ".*",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tokens consumidos por agente",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, agent, sum(total_tokens) AS tokens FROM token_usage WHERE $__timeFilter(created_at) AND agent IN ($agent) AND chat_id::text IN ($telegram_user_id) GROUP BY 1, agent ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Top usuarios por tokens consumidos",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT chat_id AS telegram_user_id, agent, sum(total_tokens) AS total_tokens, count(*) AS llamadas, round(avg(latency_ms)) AS latencia_media_ms FROM token_usage WHERE $__timeFilter(created_at) AND agent IN ($agent) AND chat_id::text IN ($telegram_user_id) GROUP BY chat_id, agent ORDER BY total_tokens DESC LIMIT 20",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Latencia media del LLM por agente (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, agent, avg(latency_ms) AS latencia_ms FROM token_usage WHERE $__timeFilter(created_at) AND agent IN ($agent) AND chat_id::text IN ($telegram_user_id) GROUP BY 1, agent ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Llamadas al LLM por estado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "postgres", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, status, count(*) AS llamadas FROM token_usage WHERE $__timeFilter(created_at) AND agent IN ($agent) AND chat_id::text IN ($telegram_user_id) GROUP BY 1, status ORDER BY 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Contadores de logs por nivel",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"fitcoach-ia\"} | json | level=\"ERROR\" [$__range]))",
          "legendFormat": "Errores",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }] },
          "mappings": []
        }
      }
    },
    {
      "id": 7,
      "title": "Warnings",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"fitcoach-ia\"} | json | level=\"WARNING\" [$__range]))",
          "legendFormat": "Warnings",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": 0 }] },
          "mappings": []
        }
      }
    },
    {
      "id": 8,
      "title": "Infos",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"fitcoach-ia\"} | json | level=\"INFO\" [$__range]))",
          "legendFormat": "Infos",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] },
          "mappings": []
        }
      }
    },
    {
      "id": 9,
      "title": "Throughput de logs (líneas/seg)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate({service_name=\"fitcoach-ia\"} | json | __error__=\"\" | level=~\"$log_level\" [$__interval]))",
          "legendFormat": "{{ level }}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 10,
      "title": "Actividad por logger",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "orientation": "auto",
        "showTooltip": true,
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (logger) (count_over_time({service_name=\"fitcoach-ia\"} | json | __error__=\"\" | level=~\"$log_level\" [$__range]))",
          "legendFormat": "{{ logger }}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 11,
      "title": "Últimos 5 errores",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showLabels": "auto",
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": 2,
        "maxLines": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"fitcoach-ia\"} | json | level=\"ERROR\" | regexp `telegram_user_id=(?P<telegram_user_id>-?\\d+)` | telegram_user_id=~\"$telegram_user_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 12,
      "title": "Últimos 5 warnings",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showLabels": "auto",
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": 2,
        "maxLines": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"fitcoach-ia\"} | json | level=\"WARNING\" | regexp `telegram_user_id=(?P<telegram_user_id>-?\\d+)` | telegram_user_id=~\"$telegram_user_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Stream de logs en vivo",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showLabels": "auto",
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": 2,
        "maxLines": 100
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"fitcoach-ia\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
