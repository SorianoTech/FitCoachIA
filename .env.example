bot_telegram_url=https://api.telegram.org/bot
bot_telegram_token=...
bot_telegram_commands=start:Inicia FitCoach,interview:Entrevista,train:Tu plan de entrenamiento,doubts:Resuelve dudas,progress:Tu progreso

# Secreto del webhook: uno distinto por bot y entorno.
bot_telegram_secret_token=...
# URL publica de ESTA app, no la de la API de Telegram.
bot_telegram_webhook_base_url=https://api.tudominio.com
# Opcional: habilita el acceso visual al diario desde el bot. Mismo dominio que la API.
# miniapp_url=https://api.tudominio.com/miniapp/
# miniapp_auth_max_age_seconds=86400
# Administradores del panel de cuotas: ids Telegram de chats privados, separados por comas.
# miniapp_admin_chat_ids=123456789,987654321

APP_ENV=dev
APP_PORT=8000
ia_base_url=https://openrouter.ai/api/v1/chat/completions
ia_token=...
ia_timeout_seconds=60
ia_model=openrouter/free
ia_temperature=1
ia_max_tokens=10000
ia_history_window_messages=20
ia_skill=interviewer

# Agente 2 (entrenador). El mesociclo completo no cabe en ia_max_tokens.
ia_trainer_skill=trainer
ia_trainer_max_tokens=4096
ia_trainer_history_window_messages=10
ia_trainer_timeout=60
# Opcionales: omitir para heredar el modelo y limites actuales, sin cambiar comportamiento.
# Elegir modelos solo tras evaluar structured outputs, seguridad y calidad.
# ia_trainer_generation_model=...
# Temperatura por tarea: omitir hereda ia_temperature; default no envia el parametro.
# ia_trainer_generation_temperature=default
# ia_trainer_consultation_model=...
# ia_trainer_consultation_temperature=default
# ia_trainer_consultation_max_tokens=1024
# ia_trainer_consultation_timeout=30
# ia_trainer_extraction_model=...
# ia_trainer_extraction_temperature=default
# ia_trainer_extraction_max_tokens=1536
# ia_trainer_extraction_timeout=30
# Ejercicios recuperados de la BD vectorial por grupo muscular.
ia_rag_top_k=8
# Agente que transforma descripciones de usuarios en propuestas estructuradas.
ia_exercise_curator_model=gpt-5.4-mini
ia_exercise_curator_temperature=0.1
ia_exercise_curator_max_tokens=1200
ia_exercise_curator_timeout=30
# Similitud coseno minima para marcar una propuesta como posible duplicado.
ia_exercise_duplicate_similarity_threshold=0.92

# Worker independiente; habilitar despues de migrar. No invoca al LLM.
training_reminders_enabled=false
training_reminder_interval_seconds=300
training_reminder_max_attempts=5

database_url=postgresql+asyncpg://user:pass@service_name:5432/db_name
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=...
POSTGRES_HOST=postgres
POSTGRES_DB=fitcoach
POSTGRES_PORT=5432

# Base de datos vectorial (catalogo de ejercicios). Solo lectura: ver
# infra/vector-db/ddl/002_2026-09-21_readonly-role.sql. Levantala con `make vector-up`.
vector_database_url=postgresql+asyncpg://user:pass@service_or_host_name:5432/db_name
VECTOR_DB_USER=fitcoach_ro
VECTOR_DB_PASSWORD=...
VECTOR_DB_HOST=pgvector
VECTOR_DB=fitcoach
VECTOR_DB_PORT=5433
VECTOR_DB_RO_PASSWORD=...

# Servicio de embeddings (infra/embedder). DEBE usar el mismo modelo que el
# corpus: all-MiniLM-L6-v2, 384 dimensiones.
embedder_url=http://embedder:8100
embedder_host=embedder
embedder_port=8100
embedder_timeout_seconds=10

# Observabilidad (opcional): sin esta variable la app no exporta trazas.
# Ver docs/observabilidad.md. Usa el mismo endpoint en .env.dev y .env.prod;
# las trazas se distinguen por entorno via APP_ENV (fijado por cada compose).
otel_exporter_otlp_endpoint=....

PGADMIN_DEFAULT_EMAIL=fitcoach@fitcoach.com
PGADMIN_DEFAULT_PASSWORD=...
PGADMIN_PORT=8010

# Cuota de consumo por chat. Opcionales: por defecto 150000 / 0.66 / 1440.
# Formulas y calibracion en docs/rate-limiter.md.
rate_limit_token_limit=1    # Punto de corte, NO techo: un turno en curso lo rebasa
rate_limit_soft_ratio=0.1   # (0, 1] — fraccion a la que se corta /interview
rate_limit_window_minutes=1 # Ventana movil sobre la que se suma el consumo

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
log_level=INFO
