# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
log_level=

# dev | prod
DEPLOYMENT_ENVIRONMENT=
# El puerto en el que publicamos la app principal con la fastAPI
APP_PORT=8000


bot_telegram_url=https://api.telegram.org/bot
bot_telegram_token=
bot_telegram_commands=start:Inicia FitCoach,interview:Entrevista,train:Entrenar!,add_exercise:Propón un ejercicio,doubts:Resuelve dudas,progress:Tu progreso
bot_telegram_secret_token=
# Aqui hay que fijar con un nombre dentro del dominio sergiosoriano.es para identificar el entorno
# Si no se indica especificamente un entorno el nombre fitcoach representa PRODUCCION
# Para el entorno de desarrollo pondriamos: https://fitcoach.dev.sergiosoriano.es
bot_telegram_webhook_base_url=https://fitcoach.sergiosoriano.es

ia_base_url=https://api.openai.com/v1
ia_token=
ia_timeout_seconds=60
ia_model=gpt-5-nano-2025-08-07
ia_temperature=0.2
# Entrenador: overrides por tarea
ia_trainer_generation_temperature=1
ia_trainer_consultation_temperature=0.2
ia_trainer_extraction_temperature=0.2

ia_max_tokens=20000
ia_history_window_messages=20
# interviewer-dev o interviewer
ia_skill=interviewer-dev
ia_interviewer_reasoning_effort=low

# Agente 2 (entrenador). El mesociclo completo no cabe en ia_max_tokens.
# trainer-dev o trainer
ia_trainer_skill=
ia_trainer_max_tokens=50000
ia_trainer_history_window_messages=10
ia_trainer_timeout=160
ia_trainer_generation_model=gpt-6-luna
ia_trainer_consultation_model=gpt-5-nano-2025-08-07
# Ejercicios recuperados de la BD vectorial por grupo muscular.
ia_rag_top_k=8

# Curator
ia_exercise_curator_model=gpt-5.4-mini
ia_exercise_curator_temperature=0.1
ia_exercise_curator_max_tokens=1200
ia_exercise_curator_timeout=30
ia_exercise_duplicate_similarity_threshold=0.92

# Por ejemplo 254881467,8389480,8884875687
bot_telegram_exercise_admin_ids=
# Mini app
miniapp_url=https://fitcoach.sergiosoriano.es/miniapp/
# Por ejemplo 254881467,8884875687,8389480
miniapp_admin_chat_ids=

# Variables del scheduler para notificaciones y evaluaciones
scheduler_enabled=true
scheduler_interval_seconds=3600

# Avisos de notificaciones de entrenamiento
training_reminder_max_attempts=5
training_reminder_retry_delay_seconds=30
training_reminder_retry_max_delay_seconds=300
training_reminder_sending_timeout_seconds=120
training_reminder_batch_size=100

# Configuración de las notificaciones de evaluaciones
evaluation_max_attempts=5
evaluation_retry_delay_seconds=30
evaluation_retry_max_delay_seconds=3600
evaluation_sending_timeout_seconds=120
evaluation_batch_size=100

# Servicio de embeddings (infra/embedder). DEBE usar el mismo modelo que el
# corpus: all-MiniLM-L6-v2, 384 dimensiones.
embedder_url=http://embedder:8100
# embedder_host=embedder
# embedder_port=8100
embedder_timeout_seconds=10

rate_limit_token_limit=15000
# 10% consumo -> Primer aviso
rate_limit_soft_ratio=0.1
# 5 min
rate_limit_window_minutes=5


####################################################################################
# PGADMIN CONFIG
PGADMIN_LISTEN_PORT=80

PGADMIN_DEFAULT_EMAIL=admin@fitcoachia.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=8010
####################################################################################

####################################################################################
# POSTGRES RDB
database_url=postgresql+asyncpg://fitcoach:*******@postgres:5432/fitcoach
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_DB=fitcoach
POSTGRES_PORT=5432
####################################################################################

####################################################################################
# Base de datos vectorial (catalogo de ejercicios). Solo lectura: ver
# infra/vector-db/ddl/002_2026-09-21_readonly-role.sql.
vector_database_url=postgresql+asyncpg://fitcoach_ro:*******@pgvector:5432/fitcoach
VECTOR_USER=fitcoach
VECTOR_PASSWORD=
VECTOR_HOST=pgvector
VECTOR_DB=fitcoach
VECTOR_PORT=5433

VECTOR_DB_RO_PASSWORD=
# Conexión limitada de escritura a pgVector
VECTOR_DB_WRITER_PASSWORD=
vector_database_writer_url=postgresql+asyncpg://fitcoach_writer:*******@pgvector:5432/fitcoach
####################################################################################

####################################################################################
# Variables de entorno necesarias para el loader que se ejecutó la primera vez que se levanto la instancia de pgVector.
# Una vez volcados los datos de ejercicios ya no es necesario volver a repetir esta carga inicial.
# Se deja el código del loader pues aporta información respecto al modelo de embedings, y podríamos querer modificar el conjunto inicial de datos y realizar una nueva carga.
# Tras la carga inicial se realizó un volcado de la base de datos y ese SQL se añade a la imagen de pgVector para que al arrancar el contenedor se inicialice la BD con ellos.
# MEDIA_DIR=/media
# JSON_PATH=/media/data/exercises.json
####################################################################################

####################################################################################
# OBSERVABILITY PROPERTIES
GF_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=https://grafana.fitcoach.sergiosoriano.es
# Severidad de las alertas de Grafana: warning en dev, critical en prod.
GF_ALERT_SEVERITY=warning

otel_exporter_otlp_endpoint=http://otel-collector:4317
####################################################################################

####################################################################################
# NGINX PROXY MANAGER (puertos del host; por defecto 80, 443 y 81 solo en 127.0.0.1)
# Podman rootless no permite puertos < 1024: en local usar 8080 / 8443.
# NPM_HTTP_PORT=8080
# NPM_HTTPS_PORT=8443
# NPM_ADMIN_PORT=81
####################################################################################
