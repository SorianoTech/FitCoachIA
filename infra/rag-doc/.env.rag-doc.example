# Copia a infra/rag-doc/.env (no se versiona).
# Puerto local del host donde se publica rag-doc (el proxy NPM apunta al contenedor, no a este puerto)
RAG_PORT=8200
RAG_LOG_LEVEL=INFO
RAG_QDRANT_COLLECTION=rag_doc
# Modelo de embeddings (debe coincidir con el de la imagen y con RAG_EMBEDDING_DIMENSIONS; si cambia, reindexa)
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_EMBEDDING_DIMENSIONS=768
# LLM: cualquier API compatible con OpenAI (OpenRouter por defecto) con un modelo abierto
RAG_LLM_BASE_URL=https://openrouter.ai/api/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_TOKENS=600
RAG_LLM_MAX_RETRIES=2
# Anti-abuso: peticiones por minuto y por IP, tope diario global y confianza en X-Forwarded-For (NPM)
RAG_RATE_LIMIT_PER_MINUTE=10
RAG_DAILY_CALL_CAP=500
RAG_TRUST_PROXY_HEADERS=true
# Pasajes recuperados por pregunta y puntuacion coseno minima para responder
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
