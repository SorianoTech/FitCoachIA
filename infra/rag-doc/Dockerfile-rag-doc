FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# El modelo vive dentro de la imagen: el arranque no depende de HuggingFace ni de la red.
ENV HF_HOME=/opt/hf
ENV RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base

WORKDIR /app

# torch solo CPU (la build CUDA multiplica la imagen); antes de requirements.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Si cambias RAG_EMBEDDING_MODEL, reconstruye la imagen y reindexa (make rag-index)
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${RAG_EMBEDDING_MODEL}')"

# Voz embebida en la imagen: Whisper (STT) y voz espanola de Piper (TTS)
ENV RAG_STT_MODEL=small
ENV RAG_STT_MODEL_DIR=/opt/whisper
ENV RAG_TTS_VOICE_PATH=/opt/piper/es_ES-davefx-medium.onnx
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('${RAG_STT_MODEL}', device='cpu', compute_type='int8', download_root='${RAG_STT_MODEL_DIR}')"
ADD https://huggingface.co/rhasspy/piper-voices/resolve/main/es/es_ES/davefx/medium/es_ES-davefx-medium.onnx /opt/piper/
ADD https://huggingface.co/rhasspy/piper-voices/resolve/main/es/es_ES/davefx/medium/es_ES-davefx-medium.onnx.json /opt/piper/
RUN chmod -R a+rX /opt/piper /opt/whisper
# Modelos ya descargados: en runtime no se consulta HuggingFace
ENV HF_HUB_OFFLINE=1

RUN useradd --create-home --uid 10001 raguser
COPY rag_doc ./rag_doc
USER raguser

EXPOSE 8200

CMD ["uvicorn", "rag_doc.main:app", "--host", "0.0.0.0", "--port", "8200"]
