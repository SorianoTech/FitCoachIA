bot_telegram_url=...
bot_telegram_token=...
bot_telegram_commands=start:Inicia FitCoach,interview:Entrevista,train:Tu plan de entrenamiento,doubts:Resuelve dudas,progress:Tu progreso

ia_base_url=...
ia_token=...
ia_timeout_seconds=...
ia_model=...
ia_temperature=...
ia_max_tokens=...
ia_history_window_messages=20
ia_skill=interviewer

# Agente 2 (entrenador). El mesociclo completo no cabe en ia_max_tokens.
ia_trainer_skill=trainer
ia_trainer_max_tokens=4096
ia_trainer_history_window_messages=10
# Ejercicios recuperados de la BD vectorial por grupo muscular.
ia_rag_top_k=8

database_url=postgresql+asyncpg://fitcoach:fitcoach@localhost:5432/fitcoach
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=...
POSTGRES_DB=fitcoach

# Base de datos vectorial (catalogo de ejercicios). Solo lectura: ver
# infra/vector-db/ddl/002_2026-09-21_readonly-role.sql. Levantala con `make vector-up`.
vector_database_url=postgresql+asyncpg://fitcoach_ro:fitcoach_ro_dev@localhost:5432/fitcoach
VECTOR_DB_USER=fitcoach_ro
VECTOR_DB_PASSWORD=...
VECTOR_DB_NAME=fitcoach

# Servicio de embeddings (infra/embedder). DEBE usar el mismo modelo que el
# corpus: all-MiniLM-L6-v2, 384 dimensiones.
embedder_url=http://localhost:8100
embedder_timeout_seconds=10

# Observabilidad (opcional): sin esta variable la app no exporta trazas.
# Ver docs/observabilidad.md. Usa el mismo endpoint en .env.dev y .env.prod;
# las trazas se distinguen por entorno via APP_ENV (fijado por cada compose).
otel_exporter_otlp_endpoint=....

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
log_level=INFO
