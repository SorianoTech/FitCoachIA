bot_telegram_url=https://api.telegram.org/bot
bot_telegram_token=.....
bot_telegram_commands=start:Inicia FitCoach,interview:Entrevista,train:Entrenar!,add_exercise:Propón un ejercicio,doubts:Resuelve dudas,progress:Tu progreso
bot_telegram_secret_token=.....
bot_telegram_webhook_base_url=https://dev.fitcoach.sergiosoriano.es

APP_ENV=dev
APP_PORT=8000
ia_base_url=https://api.openai.com/v1
ia_token=....
ia_timeout_seconds=60
ia_model=gpt-5-nano-2025-08-07
ia_temperature=0.2
# Entrenador: overrides por tarea
ia_trainer_generation_temperature=1
ia_trainer_consultation_temperature=0.2
ia_trainer_extraction_temperature=0.2

ia_max_tokens=20000
ia_history_window_messages=20
ia_skill=interviewer-dev

# Agente 2 (entrenador). El mesociclo completo no cabe en ia_max_tokens.
ia_trainer_skill=trainer-dev
ia_trainer_max_tokens=50000
ia_trainer_history_window_messages=10
ia_trainer_timeout=160
ia_trainer_generation_model=gpt-6-luna
ia_trainer_consultation_model=gpt-5-nano-2025-08-07
# Ejercicios recuperados de la BD vectorial por grupo muscular.
ia_rag_top_k=8

# Curator
ia_exercise_curator_model=gpt-5.4-mini
ia_exercise_curator_temperature=0.1
ia_exercise_curator_max_tokens=1200
ia_exercise_curator_timeout=30
ia_exercise_duplicate_similarity_threshold=0.92

scheduler_enabled=false
scheduler_interval_seconds=300

evaluation_max_attempts=5
evaluation_retry_delay_seconds=30
evaluation_retry_max_delay_seconds=3600
evaluation_sending_timeout_seconds=120
evaluation_batch_size=100

training_reminder_retry_delay_seconds=30
training_reminder_retry_max_delay_seconds=3600
training_reminder_sending_timeout_seconds=120
training_reminder_batch_size=100
training_reminder_max_attempts=5

bot_telegram_exercise_admin_ids=254881467,8389480,8884875687
# Mini app
# miniapp_url=https://dev.fitcoach.sergiosoriano.es/miniapp/
# miniapp_admin_chat_ids=254881467,8884875687,8389480
# database_url=postgresql+asyncpg://fitcoach:fitcoach@localhost:5432/fitcoach
database_url=postgresql+asyncpg://<user>:<password>@postgres-dev:5432/<schema>
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=....
POSTGRES_HOST=....
POSTGRES_DB=fitcoach
POSTGRES_PORT=5432

# Base de datos vectorial (catalogo de ejercicios). Solo lectura: ver
# infra/vector-db/ddl/002_2026-09-21_readonly-role.sql. Levantala con `make vector-up`.
vector_database_url=postgresql+asyncpg://<user>:<password>@pgvector-dev:5432/<schema>
VECTOR_DB=fitcoach


# Conexión limitada de escritura a pgVector
vector_database_writer_url=postgresql+asyncpg://<user>:<password>@pgvector-dev:5432/<schema>


# Servicio de embeddings (infra/embedder). DEBE usar el mismo modelo que el
# corpus: all-MiniLM-L6-v2, 384 dimensiones.
embedder_url=http://embedder-dev:8100
embedder_host=embedder-dev
embedder_port=8100
embedder_timeout_seconds=10

rate_limit_token_limit=15000
rate_limit_soft_ratio=0.1 # 10% consumo -> Primer aviso
rate_limit_window_minutes=5 # 0.5h

otel_exporter_otlp_endpoint=......


# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
log_level=DEBUG
